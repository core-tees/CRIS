if(NOT DEFINED TRAINER)
  message(FATAL_ERROR "TRAINER is required")
endif()

set(missing "${CMAKE_CURRENT_BINARY_DIR}/bratu_cli_missing_input")
set(output_dir "${CMAKE_CURRENT_BINARY_DIR}/bratu_cli_unused_output")
if(EXISTS "${missing}" OR EXISTS "${output_dir}")
  message(FATAL_ERROR "CLI test paths must not exist")
endif()

function(expect_failure expected)
  execute_process(COMMAND "${TRAINER}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
  if(NOT "${result}" STREQUAL "1")
    message(FATAL_ERROR "Expected a controlled failure; got ${result}: ${output}${error}")
  endif()
  string(FIND "${error}" "${expected}" match)
  if(match EQUAL -1)
    message(FATAL_ERROR "Expected '${expected}', got: ${output}${error}")
  endif()
endfunction()

set(regularized --data-dir "${missing}" --run-dir "${output_dir}")
set(earlier --train "${missing}" --validation "${missing}" --run-dir "${output_dir}")
foreach(mode regularized earlier)
  expect_failure("Unknown option: --patienc" ${${mode}} --patienc 2)
  expect_failure("Missing value for --threads" ${${mode}} --threads)
endforeach()

foreach(option --train --validation --resume --weight --portable-recovery)
  expect_failure("Option ${option} is not supported with --data-dir" ${regularized} ${option} 0)
endforeach()
foreach(option --regularization --slope-min --slope-max --slope-weight --curvature-weight)
  expect_failure("Option ${option} requires --data-dir" ${earlier} ${option} 0)
endforeach()
expect_failure("Unknown option: --unknown" --self-test --unknown 1)
expect_failure("--self-test cannot be combined with training options" --self-test --threads 1)
expect_failure("Missing required option: --run-dir" --data-dir "${missing}")
expect_failure("Missing required option: --train" --run-dir "${output_dir}")
expect_failure("Missing required option: --validation" --train "${missing}" --run-dir "${output_dir}")

# Supported options must reach data loading rather than being rejected as options.
set(common --threads 1 --max-accepted 1 --max-proposals 1 --patience 1 --block-size 1)
expect_failure("Cannot open training data:" ${regularized} ${common}
  --regularization 1e-8 --slope-min 0 --slope-max 1.015 --slope-weight 1 --curvature-weight 0.01)
expect_failure("Invalid dataset" ${earlier} ${common} --weight 0 --portable-recovery 1)
foreach(option --resume-state --initial-checkpoint)
  expect_failure("Cannot open training data:" ${regularized} --threads 1 ${option} "${missing}")
  expect_failure("Invalid dataset" ${earlier} --threads 1 ${option} "${missing}")
endforeach()
expect_failure("Invalid dataset" ${earlier} --threads 1 --resume "${missing}")

if(EXISTS "${output_dir}")
  message(FATAL_ERROR "An invalid command created an output directory")
endif()
